@article{raman2025tidy,
  title    = {Learning to Tidy Up from Household Demonstrations},
  author   = {Raman$^{*}$, Priya and Morales$^{*}$, Diego and Quinn, Avery},
  journal  = {Transactions on Robot Learning},
  volume   = {4},
  number   = {2},
  pages    = {112--131},
  year     = {2025},
  doi      = {10.5555/example.trl.2025.0412},
  abstract = {Tidying a home requires knowing where every object belongs, yet each household has its own conventions. We present a method that learns a household's placement preferences from a handful of demonstrations and generalizes them to new objects. Across ten real homes, the robot put away 87\% of objects where their owners expected them.},
  project  = {homebot}
}

@article{lindqvist2023intent,
  title    = {Inferring User Intent for Shared Autonomy under Uncertainty},
  author   = {Lindqvist, Sofia and Grant, Oliver and Quinn, Avery},
  journal  = {Journal of Assistive Robotics},
  volume   = {12},
  number   = {3},
  pages    = {201--224},
  year     = {2023},
  doi      = {10.5555/example.jar.2023.1203},
  abstract = {Assistive robot arms are hard to control with low-dimensional interfaces such as joysticks. We model the user's goal as a hidden variable and let the robot assist in proportion to its confidence. A study with twelve participants shows faster task completion and lower workload than direct teleoperation.},
  project  = {sharedcontrol}
}

